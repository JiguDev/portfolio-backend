{
  "name": "portfolio-backend",
  "version": "1.0.0",
  "description": "REST API backend for my personal portfolio",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/db-migrate.ts migrate",
    "db:migrate:baseline": "tsx scripts/db-migrate.ts baseline",
    "db:migrate:status": "tsx scripts/db-migrate.ts status"
  },
  "keywords": [
    "portfolio",
    "nodejs",
    "express",
    "typescript"
  ],
  "author": "Jigyasu Gajre",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
