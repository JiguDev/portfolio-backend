PORT=5000
HOST=0.0.0.0
NODE_ENV=development
# Frontend origins allowed to access the API
FRONTEND_URL=http://localhost:5173,http://localhost:8100
# Database configs
DATABASE_URL=postgresql://[USER]:[YOUR-PASSWORD]@[HOST]:5432/[DATABASE]
# Supabase configs
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY